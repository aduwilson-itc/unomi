if (params.containsKey(ctx._source.itemId)) {
    Map metricValue = params.get(ctx._source.itemId);
    String metricKey = metricValue.get('metricKey');

    if (ctx._source.systemProperties == null) {
        ctx._source.systemProperties = new HashMap();
    }

    if (ctx._source.systemProperties.pastEventMetrics == null) {
        ctx._source.systemProperties.pastEventMetrics = new ArrayList();
    }

    boolean exists = false;
    for (metric in ctx._source.systemProperties.pastEventMetrics) {
        if (metric.get('key') == metricKey) {
            metric.put('count', metricValue.get('count'));
            metric.put('sum', metricValue.get('sum'));
            metric.put('avg', metricValue.get('avg'));
            metric.put('metricCount', metricValue.get('metricCount'));
            exists = true;
        }
    }

    if (!exists) {
        Map newMetric = new HashMap();
        newMetric.put('key', metricKey);
        newMetric.put('count', metricValue.get('count'));
        newMetric.put('sum', metricValue.get('sum'));
        newMetric.put('avg', metricValue.get('avg'));
        newMetric.put('metricCount', metricValue.get('metricCount'));
        ctx._source.systemProperties.pastEventMetrics.add(newMetric);
    }

    ctx._source.systemProperties.put('lastUpdated', new Date());
}
